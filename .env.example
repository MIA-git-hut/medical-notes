# Copy to .env.local for local development. Never commit real credentials.
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_notes
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
API_PORT=3001
# Comma-separated immutable GitHub user IDs. Empty means no administrators.
ADMIN_GITHUB_IDS=
# Production: APP_ORIGIN=https://yixuebiji.top
# OAuth callback: <APP_ORIGIN>/api/auth/github/callback
# Use separate database and OAuth application for previews/staging.
