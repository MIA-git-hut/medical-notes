{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "api/**/*.ts", "tools/*.ts", "tests/**/*.ts", "docs/.vitepress/theme/StudyDashboard.vue", "docs/.vitepress/theme/HomeConstellation.vue", "docs/.vitepress/theme/AdminDashboard.vue", "docs/.vitepress/theme/study/**/*.ts", "playwright.config.ts"]
}
